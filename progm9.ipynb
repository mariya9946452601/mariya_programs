   ],
   "source": [
    "s = input(\"Enter a string: \")\n",
    "\n",
    "if s == s[::-1]:\n",
    "    print(\"Palindrome\")\n",
    "else:\n",
    "    print(\"Not a palindrome\")"
   ]
