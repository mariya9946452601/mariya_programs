   "source": [
    "s = input(\"Enter a string: \")\n",
    "\n",
    "if s.endswith(\"ing\"):\n",
    "    s = s + \"ly\"\n",
    "else:\n",
    "    s = s + \"ing\"\n",
    "\n",
    "print(\"Result:\", s)"
   ]
