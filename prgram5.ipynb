     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Enter comma-separated numbers: 20,30,40,60,10\n",
      "Tuple: (20, 30, 40, 60, 10)\n",
      "Average: 32.0\n"
     ]
    }
   ],
   "source": [
    "numbers = input(\"Enter comma-separated numbers: \")\n",
    "\n",
    "t = tuple(map(int, numbers.split(\",\")))\n",
    "\n",
    "print(\"Tuple:\", t)\n",
    "\n",
    "average = sum(t) / len(t)\n",
    "\n",
    "print(\"Average:\", average)"
   ]
  },
