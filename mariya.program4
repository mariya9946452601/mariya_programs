   "id": "82ae6284",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Enter colors separated by commas: green,black,yellow,blue,red\n",
      "First color: green\n",
      "Last color: red\n"
     ]
    }
   ],
   "source": [
    "colors = input(\"Enter colors separated by commas: \").split(\",\")\n",
    "\n",
    "colors = [color.strip() for color in colors]\n",
    "\n",
    "print(\"First color:\", colors[0])\n",
    "print(\"Last color:\", colors[-1])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "91208bbe",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Enter comma-separated numbers: 7,9,0,4,2,5\n",
      "List: [7, 9, 0, 4, 2, 5]\n",
      "Sum: 27\n"
     ]
    }
   ],
   "source": [
    "numbers = input(\"Enter comma-separated numbers: \")\n",
    "\n",
    "num_list = [int(x.strip()) for x in numbers.split(\",\")]\n",
    "\n",
    "print(\"List:\", num_list)\n",
    "print(\"Sum:\", sum(num_list))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "26f17d05",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Enter the filename: mariya.ipynb\n",
      "Extension: ipynb\n"
     ]
    }
   ],
   "source": [
    "filename = input(\"Enter the filename: \")\n",
    "\n",
    "extension = filename.split(\".\")[-1]\n",
    "\n",
    "print(\"Extension:\", extension)\n"
   ]
